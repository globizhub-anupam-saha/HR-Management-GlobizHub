<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_home_card"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- TOP ROW: Avatar + Name Stack + Status Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Avatar Initials -->
        <TextView
            android:id="@+id/tvItemAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_stat_card_blue"
            android:gravity="center"
            android:text="U"
            android:textColor="#0056FD"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Name & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Employee Name"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="EMP-001 · employee@globizhub.com"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Status Pill -->
        <TextView
            android:id="@+id/tvItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_card_orange"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="PENDING"
            android:textColor="#D97706"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- MIDDLE ROW: Details Pills (Type, Dates, Duration) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_stat_card_blue"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="CASUAL"
            android:textColor="#2563EB"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card_unselected"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="12/05/2026 → 14/05/2026"
            android:textColor="#334155"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvItemDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_unselected"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="2 days"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- REASON ROW -->
    <TextView
        android:id="@+id/tvItemReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Reason: Attending family event and personal commitments."
        android:textColor="#475569"
        android:textSize="13sp" />

    <!-- REJECTION REASON CALLOUT BOX (Visible when rejected) -->
    <LinearLayout
        android:id="@+id/llItemRejectionBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_stat_card_red"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvItemRejectionReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rejection Reason: Overlapping project deliverables."
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ACTION BUTTONS ROW (Visible when PENDING) -->
    <LinearLayout
        android:id="@+id/llItemActionsRow"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnItemApprove"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_emerald_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Approve"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnItemReject"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_rose_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Reject"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
