<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_home_card"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- TOP ROW: Avatar + Name Stack + Status Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Avatar Initials -->
        <TextView
            android:id="@+id/tvItemAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_stat_card_blue"
            android:gravity="center"
            android:text="U"
            android:textColor="#0056FD"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Name & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Employee Name"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="EMP-001 · employee@globizhub.com"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Status Pill -->
        <TextView
            android:id="@+id/tvItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_card_green"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="APPROVED"
            android:textColor="#059669"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SALARY & WORKING DAYS ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="NET SALARY"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemNetSalary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹85,000"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvItemDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="29 / 31 working days"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- BREAKDOWN CHIPS ROW -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemGross"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_unselected"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="Gross: ₹95,000"
                android:textColor="#334155"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemDeductions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_stat_card_red"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="Deductions: - ₹10,000"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemLop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_card_orange"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="LOP: 2 days"
                android:textColor="#D97706"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- HOLD REASON CALLOUT BOX (Visible when HELD) -->
    <LinearLayout
        android:id="@+id/llItemHoldBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_stat_card_orange"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="HOLD REASON"
            android:textColor="#92400E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemHoldReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Pending timesheet verification"
            android:textColor="#B45309"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ACTION BUTTONS ROW -->
    <LinearLayout
        android:id="@+id/llItemActions"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- Payslip Button -->
        <TextView
            android:id="@+id/btnItemPayslip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Payslip"
            android:textColor="#0056FD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Approve Button (When DRAFT) -->
        <TextView
            android:id="@+id/btnItemApprove"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_emerald_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Approve"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Mark Paid Button (When APPROVED) -->
        <TextView
            android:id="@+id/btnItemMarkPaid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_emerald_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Mark Paid"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Hold Button (When not HELD and not PAID) -->
        <TextView
            android:id="@+id/btnItemHold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_rose_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Hold"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Release Button (When HELD) -->
        <TextView
            android:id="@+id/btnItemRelease"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_blue_capsule_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Release"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
