<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Avatar Circle with Initial -->
    <FrameLayout
        android:id="@+id/flRosterAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_avatar_circle">

        <TextView
            android:id="@+id/tvRosterInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Name & Designation Stack -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRosterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Employee Name"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRosterRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Software Engineer • Engineering"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvRosterStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mint_pill"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="Active"
        android:textColor="#059669"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
